# Pass Along local/demo environment
# Copy to .env.local for Next.js local runs. Never commit real secrets.

# Runtime
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=
# Usually provided by Vercel; leave blank locally.
VERCEL_URL=

# Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256 signing secret for Supabase-issued JWTs. When set, /api/admin/* verifies
# bearer JWTs (admin claim in app_metadata.role or role) instead of the demo
# token below. Leave blank to keep using ADMIN_DEMO_TOKEN.
SUPABASE_JWT_SECRET=

# Model providers
# GOOGLE_API_KEY is preferred for Google Gemini routes. GEMINI_API_KEY is kept
# as a compatibility alias; set one, not both, unless deliberately overriding.
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Safety
# Leave blank/0 in production unless the tier-2 safety classifier is explicitly
# allowed to be unavailable. Local demo escape hatch only.
CRISIS_TIER2_OPTIONAL=0

# Admin demo gate (used only when SUPABASE_JWT_SECRET is unset)
ADMIN_DEMO_TOKEN=

# Timeouts / limits
RERANK_TIMEOUT_MS=8000
RATE_LIMIT_FIND_PER_MIN=20
RATE_LIMIT_PASS_PER_MIN=5
RATE_LIMIT_TYPEAHEAD_PER_MIN=60
